  "id": "tests/serializers/test_dataclasses.py::test_dataclass_initvar_not_required_on_union_ser#0",
  "test": "tests/serializers/test_dataclasses.py::test_dataclass_initvar_not_required_on_union_ser",
  "schema": {
   "type": "union",
   "choices": [
    {
     "type": "dataclass",
     "cls": {
      "$class": "Foo"
     },
     "fields": [
      "x"
     ],
     "schema": {
      "type": "dataclass-args",
      "dataclass_name": "Foo",
      "fields": [
       {
        "type": "dataclass-field",
        "name": "x",
        "schema": {
         "type": "int"
        }
       },
       {
        "type": "dataclass-field",
        "name": "init_var",
        "schema": {
         "type": "default",
         "schema": {
          "type": "int"
         },
         "default": 1
        },
        "init_only": true
       }
      ]
     },
     "post_init": true
    },
    {
     "type": "dataclass",
     "cls": {
      "$class": "Bar"
     },
     "fields": [
      "x"
     ],
     "schema": {
      "type": "dataclass-args",
      "dataclass_name": "Bar",
      "fields": [
       {
        "type": "dataclass-field",
        "name": "x",
        "schema": {
         "type": "int"
        }
       }
      ]
     }
    }
   ]
  },
  "config": null,
  "mode": "to_python",
  "input": {
   "$object": "Foo"
  },
  "options": {
   "warnings": "error"
  },
  "expected": {
   "output": {
    "x": 1
   }
  }
 },
