  "id": "tests/serializers/test_literal.py::test_literal_with_enum#0",
  "test": "tests/serializers/test_literal.py::test_literal_with_enum",
  "schema": {
   "type": "model",
   "cls": {
    "$class": "Yard"
   },
   "schema": {
    "type": "model-fields",
    "fields": {
     "pet": {
      "type": "model-field",
      "schema": {
       "type": "tagged-union",
       "choices": {
        "$dict": [
         [
          {
           "$enum": [
            "SomeEnum",
            "dog"
           ]
          },
          {
           "type": "model",
           "cls": {
            "$class": "Dog"
           },
           "schema": {
            "type": "model-fields",
            "fields": {
             "type": {
              "type": "model-field",
              "schema": {
               "type": "default",
               "schema": {
                "type": "literal",
                "expected": [
                 {
                  "$enum": [
                   "SomeEnum",
                   "dog"
                  ]
                 }
                ]
               },
               "default": {
                "$enum": [
                 "SomeEnum",
                 "dog"
                ]
               }
              }
             },
             "name": {
              "type": "model-field",
              "schema": {
               "type": "str"
              }
             }
            },
            "model_name": "Dog"
           }
          }
         ],
         [
          {
           "$enum": [
            "SomeEnum",
            "cat"
           ]
          },
          {
           "type": "model",
           "cls": {
            "$class": "Cat"
           },
           "schema": {
            "type": "model-fields",
            "fields": {
             "type": {
              "type": "model-field",
              "schema": {
               "type": "default",
               "schema": {
                "type": "literal",
                "expected": [
                 {
                  "$enum": [
                   "SomeEnum",
                   "cat"
                  ]
                 }
                ]
               },
               "default": {
                "$enum": [
                 "SomeEnum",
                 "cat"
                ]
               }
              }
             },
             "name": {
              "type": "model-field",
              "schema": {
               "type": "str"
              }
             }
            },
            "model_name": "Cat"
           }
          }
         ]
        ]
       },
       "discriminator": "type",
       "strict": false,
       "from_attributes": true
      }
     }
    }
   }
  },
  "config": null,
  "mode": "to_python",
  "input": {
   "$object": "Yard"
  },
  "options": {
   "mode": "json"
  },
  "expected": {
   "output": {
    "pet": {
     "name": "Rex",
     "type": "dog"
    }
   }
  }
 },
