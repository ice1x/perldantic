       "type": "str"
      }
     }
    }
   },
   "config": {
    "extra_fields_behavior": "forbid"
   }
  },
  "config": null,
  "mode": "python",
  "input": {
   "x": 1,
   "y": "some string"
  },
  "options": {},
  "expected": {
   "output": {
    "$model": {
     "class": "Other",
     "fields": {
      "x": 1,
      "y": "some string"
     },
     "fields_set": [
      "x",
      "y"
     ],
     "extra": null
    }
   }
  }
 },
